    <script>
      // --- Editor picker -------------------------------------------------
      const tabs = document.querySelectorAll<HTMLButtonElement>(".tab");
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const id = tab.dataset.target;
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.toggle("active", on);
            t.setAttribute("aria-selected", String(on));
          });
          document.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) =>
            p.classList.toggle("active", p.dataset.pane === id)
          );
          document.querySelectorAll<HTMLElement>("[data-note]").forEach((n) =>
            n.classList.toggle("active", n.dataset.note === id)
          );
        });
      });

      // Copy whatever the terminal is currently showing, install line included.
      document.querySelector<HTMLButtonElement>("[data-copy]")?.addEventListener("click", (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const active = document.querySelector<HTMLElement>(".pane-editor.active");
        const text = ["cargo install mnesio-mcp", active?.textContent ?? ""].join("\n\n");
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = "copied";
          setTimeout(() => (btn.textContent = "copy"), 1400);
        });
      });

      // --- Live learning curve -------------------------------------------
      // Reads a local mnesio-server if one is running. The page is static and
      // GitHub-hosted; the server is the visitor's own machine, so a failure
      // here is the *normal* case and must degrade to an honest empty state
      // rather than a fabricated demo curve.
      // Mirrors `mnesio_server::code::CurveResponse`. `success_rate` is null for
      // a generation with no decisive outcomes — that is *unmeasured*, not
      // zero, and the two must not be drawn the same way.
      type Point = {
        generation: number;
        success_rate: number | null;
        decisive: number;
        successes: number;
        mean_tokens: number;
      };
      type Curve = {
        points: Point[];
        committed: number;
        refused: number;
        proposed: number;
        outcomes: number;
        delta_pp: number | null;
        delta_is_meaningful: boolean;
        skipped: number;
        gate: string;
        summary: string;
        caveat: string;
        repo?: string;
      };

      const W = 720, H = 240, PAD = 14;

      function render(c: Curve) {
        const pts = c.points ?? [];
        const set = (sel: string, v: string, colour?: string) => {
          const el = document.querySelector<HTMLElement>(`[${sel}] .cf-n`);
          if (!el) return;
          el.textContent = v;
          if (colour) el.style.color = colour;
        };
        set("data-cf-committed", String(c.committed ?? 0));
        set("data-cf-refused", String(c.refused ?? 0));
        set("data-cf-outcomes", String(c.outcomes ?? 0));

        // The delta is the only claim this panel makes, so it is labelled by
        // sign, and greyed out until the server says three generations have
        // measurable rates. Two points define a line through any pair of noisy
        // samples; presenting that in colour would be a claim the data cannot
        // support.
        if (c.delta_pp == null) {
          set("data-cf-delta", "—", "#64748b");
        } else {
          const d = c.delta_pp;
          set(
            "data-cf-delta",
            `${d >= 0 ? "+" : ""}${d.toFixed(1)}pp`,
            !c.delta_is_meaningful ? "#64748b" : d > 0.5 ? "#34d399" : d < -0.5 ? "#fb7185" : "#93a1b5"
          );
        }

        // Only generations that measured something get a point. Plotting an
        // unmeasured batch at zero would draw a collapse that never happened.
        const measured = pts
          .map((p, i) => ({ i, r: p.success_rate }))
          .filter((p): p is { i: number; r: number } => p.r != null);
        if (measured.length < 2) return;

        const ys = measured.map((p) => p.r);
        const lo = Math.min(...ys, 0);
        const hi = Math.max(...ys, lo + 0.01);
        const x = (i: number) => PAD + (i * (W - PAD * 2)) / Math.max(pts.length - 1, 1);
        const y = (v: number) => H - PAD - ((v - lo) / (hi - lo)) * (H - PAD * 2);

        const d = measured
          .map((p, n) => `${n ? "L" : "M"}${x(p.i).toFixed(1)},${y(p.r).toFixed(1)}`)
          .join("");
        document.querySelector("[data-line]")?.setAttribute("d", d);
        document.querySelector("[data-area]")?.setAttribute(
          "d",
          `${d}L${x(measured[measured.length - 1].i).toFixed(1)},${H}L${x(measured[0].i).toFixed(1)},${H}Z`
        );
        document.querySelector("[data-floor]")?.setAttribute("stroke-opacity", "0");

        const g = document.querySelector("[data-points]");
        if (g) {
          g.innerHTML = measured
            .map((p) => `<circle cx="${x(p.i).toFixed(1)}" cy="${y(p.r).toFixed(1)}" r="3.5" fill="#2dd4bf"/>`)
            .join("");
        }
      }

      async function poll() {
        const state = document.querySelector("[data-state]");
        const hint = document.querySelector("[data-hint]");
        try {
          const res = await fetch("http://localhost:7777/api/code/curve", {
            signal: AbortSignal.timeout(1200),
          });
          if (!res.ok) throw new Error(String(res.status));
          const c: Curve = await res.json();
          const name = c.repo?.split("/").filter(Boolean).pop();
          state!.textContent = name ? `connected · ${name}` : "connected";
          state!.classList.add("ok");
          if (hint) {
            // The server ships its own caveat; echoing it here rather than
            // writing a second, friendlier one keeps a single wording that
            // cannot drift into something more flattering than the data.
            hint.textContent =
              c.outcomes === 0
                ? "Connected. No outcomes recorded on this repository yet — use an agent on it and call mnesio_code_outcome after each edit."
                : `${c.summary} — ${c.caveat}`;
          }
          render(c);
        } catch {
          state!.textContent = "no local server";
        }
      }
      poll();
      setInterval(poll, 15000);
    </script>

