      .term-bar {
        display: flex; align-items: center; gap: 7px; padding: 11px 14px;
        border-bottom: 1px solid var(--line); background: rgba(255, 255, 255, 0.022);
      }
      .tl { width: 10px; height: 10px; border-radius: 50%; }
      .tl-r { background: #ff5f57; } .tl-y { background: #febc2e; } .tl-g { background: #28c840; }
      .term-title { margin-left: 8px; font-size: 0.76rem; color: var(--dim); }
      .copy {
        margin-left: auto; font-family: var(--mono); font-size: 0.72rem; cursor: pointer;
        padding: 4px 11px; border-radius: 6px; color: var(--muted);
        border: 1px solid var(--line); background: transparent; transition: all 0.14s ease;
      }
      .copy:hover { color: var(--ink); border-color: var(--line-2); }
      .term-body { padding: 18px 20px; }
      .pane {
        margin: 0; font-family: var(--mono); font-size: 0.84rem; line-height: 1.75;
        color: var(--teal); white-space: pre-wrap; word-break: break-word;
      }
      .pane-editor { display: none; color: var(--ink); margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); }
      .pane-editor.active { display: block; }
      .term-foot { padding: 0 20px 16px; }
      .note { display: none; margin: 0; font-size: 0.82rem; color: var(--dim); }
      .note.active { display: block; }

      .tools { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 28px; }
      .tool { border: 1px solid var(--line); border-radius: 13px; padding: 20px; background: var(--surface); }
      .tool-name { font-size: 0.83rem; color: var(--teal); display: block; margin-bottom: 9px; }
      .tool p { margin: 0; font-size: 0.87rem; color: var(--muted); line-height: 1.55; }

      /* ---------- curve ---------- */
      .curve-card {
        border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.008));
      }
      .curve-head {
        display: flex; justify-content: space-between; align-items: center; gap: 16px;
        padding: 16px 20px; border-bottom: 1px solid var(--line); flex-wrap: wrap;
      }
      .curve-repo { font-size: 0.78rem; color: var(--dim); }
      .curve-state {
        margin-left: 12px; font-size: 0.74rem; font-family: var(--mono);
        padding: 3px 9px; border-radius: 6px; color: var(--dim);
        background: rgba(255, 255, 255, 0.05);
      }
      .curve-state.ok { color: var(--emerald); background: rgba(52, 211, 153, 0.12); }
      .curve-legend { display: flex; gap: 16px; font-size: 0.76rem; color: var(--muted); }
      .curve-legend span { display: inline-flex; align-items: center; gap: 6px; }
      .sw { width: 14px; height: 2px; border-radius: 2px; display: inline-block; }
      .sw-teal { background: var(--teal); } .sw-slate { background: var(--dim); } .sw-rose { background: var(--rose); }
      .curve { width: 100%; height: 240px; display: block; }
      .curve-foot {
        display: grid; grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--line);
      }
      .cf { padding: 18px 20px; border-right: 1px solid var(--line); }
      .cf:last-child { border-right: none; }
      .cf-n { display: block; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
      .cf-l { font-size: 0.78rem; color: var(--dim); }
      .curve-hint {
        margin: 0; padding: 15px 20px; font-size: 0.79rem; color: var(--dim);
        border-top: 1px solid var(--line); background: rgba(0, 0, 0, 0.22);
      }
      .curve-hint b { color: var(--teal); font-weight: 400; }

      /* ---------- comparison ---------- */
      .table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; }
      .cmp { width: 100%; border-collapse: collapse; min-width: 900px; font-size: 0.88rem; }
      .cmp th, .cmp td { padding: 15px 18px; text-align: left; border-bottom: 1px solid var(--line); }
      .cmp thead th { font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); font-weight: 600; }
      .cmp thead th.us { color: var(--teal); }
      .cmp tbody th { font-weight: 600; color: var(--ink); width: 200px; }
      .cmp td { color: var(--muted); }
      .cmp td.us { color: var(--ink); background: rgba(45, 212, 191, 0.05); }
      .cmp td.yes { color: var(--emerald); }
      .cmp td.us.yes { color: var(--emerald); }
      .cmp td.no { color: var(--dim); }
      .cmp tbody tr:last-child th, .cmp tbody tr:last-child td { border-bottom: none; }
      .cmp-note { margin-top: 16px; font-size: 0.85rem; color: var(--dim); }

      /* ---------- honest ---------- */
      .honest { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
      .hcard {
        border: 1px solid var(--line); border-radius: 15px; padding: 24px;
        background: var(--surface);
      }
      .hcard-bad { border-top: 2px solid rgba(251, 113, 133, 0.5); }
      .hcard-num {
        font-size: 2.1rem; font-weight: 800; letter-spacing: -0.035em;
        color: var(--rose); line-height: 1; margin-bottom: 12px;
      }
      .hcard h3 { margin: 0 0 10px; font-size: 1.02rem; letter-spacing: -0.015em; }
      .hcard p { margin: 0 0 12px; font-size: 0.87rem; color: var(--muted); line-height: 1.6; }
      .hcard-but {
        margin: 0 !important; padding-top: 12px; border-top: 1px solid var(--line);
        color: var(--dim) !important; font-size: 0.83rem !important;
      }
      .hcard .mono { color: var(--teal); font-size: 0.85em; }

      /* ---------- rules ---------- */
      .rules { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
      .rule { border: 1px solid var(--line); border-radius: 13px; padding: 20px; background: var(--surface); }
      .rule-n { font-size: 0.74rem; color: var(--teal); display: block; margin-bottom: 11px; }
      .rule h3 { margin: 0 0 8px; font-size: 0.96rem; letter-spacing: -0.015em; line-height: 1.35; }
      .rule p { margin: 0; font-size: 0.84rem; color: var(--muted); line-height: 1.55; }

      /* ---------- cta ---------- */
      .cta { padding: 110px 0; text-align: center; border-top: 1px solid var(--line); position: relative; overflow: hidden; }
      .cta::before {
        content: ""; position: absolute; width: 900px; height: 460px;
        top: -240px; left: 50%; transform: translateX(-50%); filter: blur(120px); opacity: 0.42;
        background: radial-gradient(circle, rgba(45, 212, 191, 0.35), rgba(99, 102, 241, 0.22), transparent 70%);
      }
      .cta-inner { position: relative; }
      .cta h2 { font-size: clamp(2rem, 4.4vw, 3rem); letter-spacing: -0.035em; margin: 0 0 16px; font-weight: 800; }
      .cta p { color: var(--muted); max-width: 54ch; margin: 0 auto 30px; font-size: 1.05rem; }
      .cta .actions { justify-content: center; }

      /* ---------- footer ---------- */
      .foot { border-top: 1px solid var(--line); background: var(--bg-alt); padding-top: 56px; }
      .foot-inner { display: grid; grid-template-columns: 1.2fr 2fr; gap: 48px; padding-bottom: 44px; }
      .brand-foot { font-size: 1.1rem; margin-bottom: 12px; }
      .foot-tag { color: var(--dim); font-size: 0.88rem; margin: 0; max-width: 38ch; line-height: 1.6; }
      .foot-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
      .foot-links h4 {
        font-size: 0.73rem; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--dim); margin: 0 0 12px; font-weight: 600;
      }
      .foot-links a { display: block; font-size: 0.88rem; color: var(--muted); padding: 4px 0; }
      .foot-links a:hover { color: var(--ink); }
      .foot-bottom {
        display: flex; justify-content: space-between; padding-block: 20px;
        border-top: 1px solid var(--line); font-size: 0.78rem; color: var(--dim); gap: 16px; flex-wrap: wrap;
      }

      /* ---------- responsive ---------- */
      @media (max-width: 1080px) {
        .loop, .rules { grid-template-columns: repeat(2, 1fr); }
        .honest { grid-template-columns: repeat(2, 1fr); }
      }
      @media (max-width: 900px) {
        .hero-grid { grid-template-columns: 1fr; gap: 40px; }
        .strip-grid { grid-template-columns: repeat(2, 1fr); gap: 26px; }
        .nav-links { display: none; }
        .tools { grid-template-columns: 1fr; }
        .foot-inner { grid-template-columns: 1fr; gap: 32px; }
      }
      @media (max-width: 640px) {
        .section { padding: 72px 0; }
        .loop, .rules, .honest { grid-template-columns: 1fr; }
        .curve-foot { grid-template-columns: repeat(2, 1fr); }
        .cf:nth-child(2) { border-right: none; }
        .cf:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
        .foot-links { grid-template-columns: 1fr 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }
    </style>
  </body>
</html>
